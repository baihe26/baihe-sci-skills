          },
          "visual_style": {
            "type": "string",
            "minLength": 1
          },
          "view_angle": {
            "type": "string",
            "minLength": 1
          },
          "palette_role": {
            "type": "string",
            "minLength": 1
          },
          "editable_type": {
            "type": "string",
            "enum": [
              "native_vector",
