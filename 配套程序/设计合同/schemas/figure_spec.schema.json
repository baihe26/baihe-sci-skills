{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scientific-visual-compiler:figure-spec:1.0.0",
  "title": "Scientific Visual Compiler FigureSpec V1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_text": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "epistemic_status": {
                "type": "string",
                "minLength": 1
              },
              "derived_from": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "path",
              "sha256",
              "epistemic_status",
              "derived_from"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "design_status": {
          "type": "string",
          "enum": [
            "DRAFT_NEEDS_REVIEW"
          ]
        }
      },
      "required": [
        "title",
        "compiler_version",
        "input_sha256",
        "input_text",
        "sources",
        "design_status"
      ],
      "additionalProperties": false
    },
    "figure_type": {
      "type": "string",
      "enum": [
        "MECHANISM_FIGURE",
        "GRAPHICAL_ABSTRACT",
        "WORKFLOW_TECHNICAL_ROUTE"
      ]
    },
    "central_message": {
      "type": "string",
      "minLength": 1
    },
    "supporting_messages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "scientific_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "claim_kind": {
            "type": "string",
            "enum": [
              "measured_result",
              "inferred_mechanism",
              "hypothesis",
              "procedure",
              "context",
              "negated_claim"
            ]
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "KNOWN",
              "DIRECTLY_SUPPORTED",
              "INFERRED",
              "HYPOTHESIZED",
              "OPTIONAL_DECORATIVE"
            ]
          },
          "source_span": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "quote",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "supporting_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          }
