        "hero_entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "minItems": 0
        },
        "support_entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "minItems": 0
        },
        "reading_order": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "minItems": 1
        },
        "label_font_pt": {
          "type": "number"
        },
        "title_font_pt": {
          "type": "number"
        }
      },
      "required": [
        "hero_entity_ids",
        "support_entity_ids",
        "reading_order",
        "label_font_pt",
        "title_font_pt"
      ],
      "additionalProperties": false
