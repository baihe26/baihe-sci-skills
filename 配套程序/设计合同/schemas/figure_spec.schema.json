          },
          "scientific_role": {
            "type": "string",
            "minLength": 1
          },
          "visual_role": {
            "type": "string",
            "enum": [
              "hero",
              "support",
              "context"
            ]
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "preferred_representation": {
            "type": "string",
            "enum": [
              "native_vector",
              "asset_library",
              "procedural",
              "generated_asset"
            ]
          },
          "repeat_consistency_key": {
            "type": "string",
            "minLength": 1
          },
          "source_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "quote",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "zone_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "x,y,width,height in canvas viewBox units; not legacy xyxy"
          },
          "color_role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "canonical_name",
          "display_label",
          "entity_type",
          "scientific_role",
          "visual_role",
          "importance",
          "preferred_representation",
          "repeat_consistency_key",
          "source_spans",
          "zone_id",
          "bbox",
          "color_role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "relation_type": {
            "type": "string",
            "enum": [
              "temporal_order",
              "activation",
              "inhibition",
              "association",
              "spatial",
              "material_formation",
              "proposed_effect"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "forward",
              "undirected"
            ]
          },
          "certainty": {
            "type": "string",
            "enum": [
              "KNOWN",
              "DIRECTLY_SUPPORTED",
              "INFERRED",
              "HYPOTHESIZED",
              "OPTIONAL_DECORATIVE"
            ]
          },
          "visual_encoding": {
            "type": "string",
            "enum": [
              "solid_arrow",
              "dashed_arrow",
              "inhibition_bar",
              "dashed_inhibition_bar",
