        "prp": {
          "type": "string",
          "minLength": 1
        },
        "cell": {
          "type": "string",
          "minLength": 1
        },
        "tissue": {
          "type": "string",
          "minLength": 1
        },
        "molecule": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "material",
        "prp",
        "cell",
        "tissue",
        "molecule",
        "stage",
        "outcome",
        "uncertainty",
        "text"
      ],
      "additionalProperties": false
