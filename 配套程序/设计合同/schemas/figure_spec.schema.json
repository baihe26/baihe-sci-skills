            "type": "string",
            "enum": [
              "asset_library",
              "procedural",
              "generated_asset"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "entity_id",
          "scientific_meaning",
          "visual_style",
          "view_angle",
          "palette_role",
          "editable_type",
          "reuse_constraints",
          "preferred_source",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "render_preferences": {
      "type": "object",
      "properties": {
        "prefer_direct": {
          "const": true
        },
        "allow_image_guided": {
          "type": "boolean"
        },
        "explore_visual_directions": {
          "type": "boolean"
        },
