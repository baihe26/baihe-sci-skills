      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "KNOWN",
          "DIRECTLY_SUPPORTED",
          "INFERRED",
          "HYPOTHESIZED",
          "OPTIONAL_DECORATIVE"
        ]
      },
      "minItems": 1
    },
    "story_direction": {
      "type": "string",
      "enum": [
        "left_to_right",
        "top_to_bottom",
        "material_to_cell_to_tissue",
        "input_process_output",
        "comparison",
        "center_out"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "entity_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "zone_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "hero",
              "support"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "zone_ids",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "layout_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "x,y,width,height in canvas viewBox units"
          },
          "role": {
            "type": "string",
            "enum": [
              "hero",
              "support",
              "context"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "bbox",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "display_label": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "material",
              "cell",
              "tissue",
              "molecule",
              "intervention",
              "stage",
              "outcome",
              "equipment",
              "symbol"
