            ]
          },
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "relation_type",
          "direction",
          "certainty",
          "visual_encoding",
          "claim_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "relationship_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "waypoints": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2
          },
          "encoding": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "relationship_id",
          "waypoints",
          "encoding"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "entity_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "native_required": {
            "const": true
          }
        },
        "required": [
          "id",
          "entity_id",
          "text",
          "native_required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
