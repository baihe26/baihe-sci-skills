              }
            },
            "required": [
              "kind",
              "data"
            ],
            "additionalProperties": false
          },
          "render_method": {
            "type": "string",
            "enum": [
              "NATIVE_VECTOR",
              "PROCEDURAL_VECTOR",
              "REUSABLE_ASSET",
              "GENERATED_ASSET",
              "RASTER_LAST_RESORT"
            ]
