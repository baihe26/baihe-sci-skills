          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "pt",
            "px",
            "mm"
          ]
        },
        "origin": {
          "const": "TOP_LEFT"
        }
      },
      "required": [
        "width",
        "height",
        "unit",
        "origin"
      ],
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "z_order": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "z_order"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
