            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x_min,y_min,x_max,y_max], top-left origin; adapter converts to Illustrator points"
          },
          "z_order": {
            "type": "integer"
          },
          "style_token": {
            "type": "string",
            "minLength": 1
          },
